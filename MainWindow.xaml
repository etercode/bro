<Window x:Class="Bro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="bro!" Icon="/assets/bro.ico" Width="1400" Height="880" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#18181B">

    <!-- Borderless window that keeps native resizing, snapping and the Windows 11 frame -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="MenuMuted" Color="#8E8E95" />
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="#ECECEE" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="12,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#36363B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- The browser's own interface: ui/index.html -->
        <wv2:WebView2 x:Name="UiView" Margin="4" />

        <!-- One WebView2 per tab lives here, positioned over the page area the UI reserves -->
        <Grid x:Name="TabHost" HorizontalAlignment="Left" VerticalAlignment="Top" Width="0" Height="0" />

        <!-- Popups are their own windows, so they can float above the page -->
        <Popup x:Name="MenuPopup" StaysOpen="False" AllowsTransparency="True"
               Placement="Relative" PlacementTarget="{Binding ElementName=UiView}" PopupAnimation="Fade">
            <Border x:Name="MenuCard" Background="#242427" BorderBrush="#38383D" BorderThickness="1"
                    CornerRadius="12" Padding="6" MinWidth="250"
                    TextElement.FontFamily="Segoe UI Variable Text, Segoe UI">
                <StackPanel x:Name="MenuItems" />
            </Border>
        </Popup>

        <!-- Address bar suggestions (history, bookmarks, search) -->
        <Popup x:Name="SuggestPopup" StaysOpen="True" AllowsTransparency="True" Focusable="False"
               Placement="Relative" PlacementTarget="{Binding ElementName=UiView}">
            <Border x:Name="SuggestCard" Background="#232326" BorderBrush="#3A3A40" BorderThickness="1"
                    CornerRadius="16" Padding="6"
                    TextElement.FontFamily="Segoe UI Variable Text, Segoe UI">
                <StackPanel x:Name="SuggestItems" />
            </Border>
        </Popup>
    </Grid>
</Window>
